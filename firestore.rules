// =========================================================================
// PRESENZA CLOUD FIRESTORE SECURITY RULES
// Rules Version: 2
// Revision: 2.1 (Updated September 2026 - Production Architecture)
// =========================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userDoc().role
        : (exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
            ? 'teacher'
            : (request.auth.token.email == 'admin@presenza.edu' || request.auth.token.email.matches('admin@.*') ? 'admin' : 'student'));
    }

    function isUserAdmin() {
      return signedIn() && (
        request.auth.token.email == 'admin@presenza.edu' ||
        request.auth.token.email.matches('admin@.*') ||
        getUserRole() == 'admin'
      );
    }

    function isTeacherOrAdmin() {
      return signedIn() && (
        isUserAdmin() ||
        getUserRole() == 'teacher' ||
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) ||
        request.auth.token.email.matches('.*@faculty\\.presenza\\.edu')
      );
    }

    // Users Collection (Profile creation & access)
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == uid || isUserAdmin());
      allow delete: if isUserAdmin();
    }

    // Students Collection
    match /students/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == uid || isTeacherOrAdmin());
      allow delete: if isUserAdmin();

      match /attendance/{recordId} {
        allow read: if signedIn() && (request.auth.uid == uid || isTeacherOrAdmin());
        allow write: if signedIn();
      }
    }

    // Teachers Collection
    match /teachers/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == uid || isUserAdmin());
      allow delete: if isUserAdmin();
    }

    // User Sessions (Single Device Login)
    match /user_sessions/{id} {
      allow read, write: if signedIn();
    }

    // Courses, Batches, Subjects (Public read for registration dropdowns)
    match /courses/{id} {
      allow read: if true;
      allow write: if isTeacherOrAdmin();
    }

    match /batches/{id} {
      allow read: if true;
      allow write: if isTeacherOrAdmin();
    }

    match /subjects/{id} {
      allow read: if true;
      allow write: if isTeacherOrAdmin();
    }

    // Attendance Sessions (Created and controlled by teachers/admins)
    match /sessions/{id} {
      allow read: if signedIn();
      allow write: if isTeacherOrAdmin();
    }

    // Attendance Records (Students can submit their own check-ins, teachers can manage and mark absentees)
    match /attendance_records/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        (request.resource.data.studentId == request.auth.uid && 
         id == request.resource.data.attendanceSessionId + '_' + request.auth.uid &&
         exists(/databases/$(database)/documents/sessions/$(request.resource.data.attendanceSessionId)) &&
         get(/databases/$(database)/documents/sessions/$(request.resource.data.attendanceSessionId)).data.isActive == true) ||
        isTeacherOrAdmin()
      );
      allow update, delete: if isTeacherOrAdmin();
    }

    // Circulars & Activities
    // (Teachers/Admins can publish directly; students can submit pending notices or publish unofficial activities)
    match /circulars/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        isTeacherOrAdmin() ||
        (request.resource.data.authorId == request.auth.uid && (
          request.resource.data.isOfficial == false ||
          request.resource.data.status == 'pending'
        ))
      );
      allow update: if signedIn() && (
        isTeacherOrAdmin() || 
        resource.data.authorId == request.auth.uid ||
        // Allow any signed-in user to react (like, clap, fire) or mark interested/going
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userReactions', 'reactionCounts', 'interestedUids', 'updatedAt'])
      );
      allow delete: if isTeacherOrAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    match /events/{id} {
      allow read: if signedIn();
      allow write: if isTeacherOrAdmin();
    }

    match /schedules/{id} {
      allow read: if signedIn();
      allow write: if isTeacherOrAdmin();
    }

    // Student Profile Update Requests (Subject to Teacher/Admin Approval)
    match /profile_update_requests/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid;
      allow update: if isTeacherOrAdmin() || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow delete: if isTeacherOrAdmin();
    }

    // Policies, Leaderboard, Notifications & Audit Logs
    match /policies/{id} {
      allow read: if signedIn();
      allow write: if isUserAdmin();
    }

    match /leaderboard/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && (id == request.auth.uid || isTeacherOrAdmin());
    }

    match /notifications/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isUserAdmin());
      allow create: if signedIn();
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isUserAdmin());
    }

    match /audit_logs/{id} {
      allow read: if isUserAdmin();
      allow create: if signedIn();
      allow update, delete: if false; // Append-only audit trail
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════════════════

    /// Returns the authenticated user's role from the /users/{uid} document.
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    /// Check if the authenticated user is an admin.
    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    /// Check if the authenticated user is a teacher.
    function isTeacher() {
      return request.auth != null && getUserRole() == 'teacher';
    }

    /// Check if the authenticated user is a student.
    function isStudent() {
      return request.auth != null && getUserRole() == 'student';
    }

    /// Check if the authenticated user owns this document.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ═══════════════════════════════════════════════════════════════════
    // USERS COLLECTION
    // ═══════════════════════════════════════════════════════════════════
    //
    // users/{uid}
    //   - Students can read their own profile
    //   - Teachers can read their own profile
    //   - Admins can read/write all profiles
    //   - Only admins can create new user profiles
    //   - Users cannot change their own role (only admin can)
    //
    match /users/{uid} {
      allow read: if request.auth != null && (isOwner(uid) || isAdmin());

      // Only admins can create user profiles (provisioning)
      allow create: if isAdmin();

      // Users can update their own profile, but NOT their role.
      // Admins can update any profile including role.
      allow update: if request.auth != null && (
        (isOwner(uid) && !('role' in request.resource.data && request.resource.data.role != resource.data.role))
        || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // STUDENTS COLLECTION
    // ═══════════════════════════════════════════════════════════════════
    //
    // students/{uid}
    //   - Students can read their own profile
    //   - Teachers and admins can read any student profile
    //   - Only admins can write student profiles
    //
    match /students/{uid} {
      allow read: if request.auth != null && (
        isOwner(uid) || isTeacher() || isAdmin()
      );
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // TEACHERS COLLECTION
    // ═══════════════════════════════════════════════════════════════════
    //
    // teachers/{uid}
    //   - All authenticated users can read teacher profiles
    //   - Only admins can write teacher profiles
    //
    match /teachers/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // COURSES / SUBJECTS / BATCHES
    // ═══════════════════════════════════════════════════════════════════
    //
    // Read by all authenticated users.
    // Write by admin only.
    //
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /batches/{batchId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // ATTENDANCE SESSIONS
    // ═══════════════════════════════════════════════════════════════════
    //
    // sessions/{sessionId}
    //   - All authenticated users can read (students need to scan QR)
    //   - Teachers can create sessions
    //   - Teachers can update their own sessions (e.g., close them)
    //   - Admins can do everything
    //
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if isTeacher() || isAdmin();
      allow update: if request.auth != null && (
        resource.data.teacherId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // ATTENDANCE RECORDS
    // ═══════════════════════════════════════════════════════════════════
    //
    // attendance_records/{recordId}
    //   - Students can read their own records
    //   - Teachers can read records for sessions they own
    //   - Admins can read all records
    //   - Students can create their own check-in records
    //   - Teachers and admins can create/update records (manual attendance)
    //   - Students CANNOT modify existing records
    //   - Only admins can delete records
    //
    match /attendance_records/{recordId} {
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        isAdmin()
      );

      // Students can create a record only for themselves
      allow create: if request.auth != null && (
        (isStudent() && request.resource.data.studentId == request.auth.uid) ||
        isTeacher() ||
        isAdmin()
      );

      // Only teachers (for their sessions) and admins can update records
      allow update: if request.auth != null && (
        (isTeacher() && resource.data.teacherId == request.auth.uid) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // CIRCULARS
    // ═══════════════════════════════════════════════════════════════════
    //
    // circulars/{circularId}
    //   - All authenticated users can read
    //   - Teachers and admins can write
    //
    match /circulars/{circularId} {
      allow read: if request.auth != null;
      allow write: if isTeacher() || isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // EVENTS
    // ═══════════════════════════════════════════════════════════════════
    //
    // events/{eventId}
    //   - All authenticated users can read
    //   - Only admins can write
    //
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // NOTIFICATIONS
    // ═══════════════════════════════════════════════════════════════════
    //
    // notifications/{notifId}
    //   - Users can only read their own notifications
    //   - Users can update their own notifications (mark as read)
    //   - Teachers and admins can create notifications
    //   - Only admins can delete notifications
    //
    match /notifications/{notifId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow create: if isTeacher() || isAdmin();

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // LEADERBOARD
    // ═══════════════════════════════════════════════════════════════════
    //
    // leaderboard/{entryId}
    //   - All authenticated users can read
    //   - Only admins can write (computed server-side or by admin)
    //
    match /leaderboard/{entryId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // ATTENDANCE POLICIES
    // ═══════════════════════════════════════════════════════════════════
    //
    // policies/{policyId}
    //   - All authenticated users can read
    //   - Only admins can write
    //
    match /policies/{policyId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // AUDIT LOGS
    // ═══════════════════════════════════════════════════════════════════
    //
    // audit_logs/{logId}
    //   - Only admins can read and write
    //
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // SCHEDULES
    // ═══════════════════════════════════════════════════════════════════
    //
    // schedules/{scheduleId}
    //   - All authenticated users can read
    //   - Teachers and admins can write
    //
    match /schedules/{scheduleId} {
      allow read: if request.auth != null;
      allow write: if isTeacher() || isAdmin();
    }
  }
}

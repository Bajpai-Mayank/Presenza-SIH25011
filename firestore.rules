rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isUserAdmin() {
      return signedIn() && (
        request.auth.token.email == 'admin@presenza.edu' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Users Collection (Profile creation & access)
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == uid || isUserAdmin());
      allow delete: if isUserAdmin();
    }

    // Students Collection
    match /students/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == uid || isUserAdmin());
      allow delete: if isUserAdmin();
    }

    // Teachers Collection
    match /teachers/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == uid || isUserAdmin());
      allow delete: if isUserAdmin();
    }

    // Courses, Batches, Subjects (Public read for registration dropdowns)
    match /courses/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /batches/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /subjects/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Attendance Sessions & Records
    match /sessions/{id} {
      allow read, write: if signedIn();
    }

    match /attendance_records/{id} {
      allow read, write: if signedIn();
    }

    // Circulars, Events & Schedules
    match /circulars/{id} {
      allow read, write: if signedIn();
    }

    match /events/{id} {
      allow read, write: if signedIn();
    }

    match /schedules/{id} {
      allow read, write: if signedIn();
    }

    // Policies, Leaderboard, Notifications & Audit Logs
    match /policies/{id} {
      allow read, write: if signedIn();
    }

    match /leaderboard/{id} {
      allow read, write: if signedIn();
    }

    match /notifications/{id} {
      allow read, write: if signedIn();
    }

    match /audit_logs/{id} {
      allow read, write: if signedIn();
    }
  }
}
